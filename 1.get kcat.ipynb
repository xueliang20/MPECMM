import requests
import pandas as pd
from typing import Dict, List, Optional

class KcatHarvester:
    """
    酶kcat值采集器
    从多个公开数据源获取酶催化常数
    """
    
    def __init__(self):
        self.sources = {
            'brenda': 'https://www.brenda-enzymes.org/',
            'sabiork': 'http://sabiork.h-its.org/'
        }
        
    def get_kcat_from_brenda(self, ec_number: str, organism: str = None) -> List[Dict]:
        """
        从BRENDA数据库获取kcat值
        
        Args:
            ec_number: EC编号 (e.g., "1.1.1.1")
            organism: 生物体名称 (可选)
            
        Returns:
            包含kcat值的字典列表
        """
        try:
            # BRENDA API调用示例 (需要申请API密钥)
            headers = {'API-Key': 'YOUR_BRENDA_API_KEY'}
            params = {
                'ec': ec_number,
                'parameter': 'kcat',
                'organism': organism
            }
            
            response = requests.get(
                f"{self.sources['brenda']}/api/kinetics.php",
                params=params,
                headers=headers,
                timeout=30
            )
            
            if response.status_code == 200:
                return self._parse_brenda_response(response.json())
            else:
                print(f"BRENDA API错误: {response.status_code}")
                return []
                
        except Exception as e:
            print(f"从BRENDA获取数据时出错: {str(e)}")
            return []
  
    
    def _parse_brenda_response(self, data: dict) -> List[Dict]:
        """解析BRENDA API响应"""
        kcat_values = []
        for entry in data.get('data', []):
            kcat_values.append({
                'ec_number': entry.get('ec'),
                'organism': entry.get('organism'),
                'kcat_value': entry.get('kcat'),
                'kcat_unit': entry.get('unit'),
                'substrate': entry.get('substrate'),
                'source': 'BRENDA'
            })
        return kcat_values
    
    
    def harvest_kcats(self, ec_numbers: List[str], output_file: str = None) -> pd.DataFrame:
        """
        从多个数据源采集kcat值
        
        Args:
            ec_numbers: EC编号列表
            output_file: 输出文件路径 (可选)
            
        Returns:
            包含所有kcat值的DataFrame
        """
        all_kcats = []
        
        for ec in ec_numbers:
            print(f"正在处理 {ec}...")
            
            # 从BRENDA获取
            brenda_kcats = self.get_kcat_from_brenda(ec)
            all_kcats.extend(brenda_kcats)
            
            # 从Sabiork获取
            sabiork_kcats = self.get_kcat_from_sabiork(ec)
            all_kcats.extend(sabiork_kcats)
        
        df = pd.DataFrame(all_kcats)
        
        # 数据清洗
        if not df.empty:
            df = self._clean_kcat_data(df)
        
        # 保存结果
        if output_file:
            df.to_csv(output_file, index=False)
            print(f"结果已保存至: {output_file}")
        
        return df
    
    def _clean_kcat_data(self, df: pd.DataFrame) -> pd.DataFrame:
        """清洗和标准化kcat数据"""
        # 移除缺失值
        df = df.dropna(subset=['kcat_value'])
        
        # 单位标准化 (转换为1/s)
        def standardize_units(row):
            kcat = row['kcat_value']
            unit = row.get('kcat_unit', '')
            
            if 'min' in unit:
                return kcat / 60  # 从每分钟转换为每秒
            elif 'h' in unit:
                return kcat / 3600  # 从每小时转换为每秒
            else:
                return kcat  # 假设已经是每秒
        
        df['kcat_standardized'] = df.apply(standardize_units, axis=1)
        
        return df

# 使用示例
if __name__ == "__main__":
    harvester = KcatHarvester()
    
    # 示例EC编号
    ec_numbers = ["1.1.1.1", "2.7.1.1", "4.1.1.39"]
    
    # 采集kcat值
    kcat_df = harvester.harvest_kcats(
        ec_numbers=ec_numbers,
        output_file="enzyme_kcats.csv"
    )
    
    print(f"成功获取 {len(kcat_df)} 条kcat记录")
    print(kcat_df.head())
import pandas as pd
import numpy as np
from typing import Dict, List, Optional
import re
import requests

class KcatKeggUniprotMatcher:
    """
    kcat值、KEGG基因编号和UniProt蛋白编号匹配器
    """
    
    def __init__(self):
        self.kegg_api_base = "http://rest.kegg.jp"
        self.uniprot_api_base = "https://www.ebi.ac.uk/proteins/api"
        
    def load_kcat_data(self, kcat_file: str) -> pd.DataFrame:
        """加载kcat数据"""
        kcat_df = pd.read_csv(kcat_file)
        # 标准化EC编号和生物体信息
        kcat_df['ec_number_clean'] = kcat_df['ec_number'].apply(self.standardize_ec)
        kcat_df['organism_clean'] = kcat_df['organism'].apply(self.standardize_organism)
        return kcat_df
    
    def load_proteomics_data(self, proteomics_file: str) -> pd.DataFrame:
        """加载蛋白质组学数据（包含UniProt ID和丰度）"""
        proteomics_df = pd.read_csv(proteomics_file)
        # 标准化UniProt ID
        proteomics_df['uniprot_id_clean'] = proteomics_df['uniprot_id'].apply(self.standardize_uniprot_id)
        return proteomics_df
    
    def load_kegg_gene_data(self, kegg_gene_file: str) -> pd.DataFrame:
        """加载KEGG基因数据"""
        kegg_gene_df = pd.read_csv(kegg_gene_file)
        kegg_gene_df['gene_id_clean'] = kegg_gene_df['kegg_gene_id'].apply(self.standardize_kegg_gene_id)
        return kegg_gene_df
    
    def standardize_ec(self, ec_number: str) -> str:
        """标准化EC编号格式"""
        if pd.isna(ec_number):
            return None
        ec_str = str(ec_number).strip()
        # 移除可能的版本标记或其他后缀
        ec_str = re.sub(r'[^\d\.]', '', ec_str)
        # 确保EC编号格式正确
        if re.match(r'^\d+\.\d+\.\d+\.\d+$', ec_str):
            return ec_str
        return None
    
    def standardize_uniprot_id(self, uniprot_id: str) -> str:
        """标准化UniProt ID格式"""
        if pd.isna(uniprot_id):
            return None
        uniprot_str = str(uniprot_id).strip().upper()
        # 匹配UniProt ID模式 (如 P12345, A0A023ABC1)
        if re.match(r'^[A-N,R-Z][0-9][A-Z][A-Z,0-9][A-Z,0-9][0-9]$|^[O,P,Q][0-9][A-Z,0-9][A-Z,0-9][A-Z,0-9][0-9]$', uniprot_str):
            return uniprot_str
        return None
    
    def standardize_kegg_gene_id(self, gene_id: str) -> str:
        """标准化KEGG基因ID格式"""
        if pd.isna(gene_id):
            return None
        gene_str = str(gene_id).strip()
        
        if re.match(r'^[a-z]{3,4}:[a-zA-Z0-9_\.]+$', gene_str):
            return gene_str
        return None
    
    def standardize_organism(self, organism: str) -> str:
        """标准化生物体名称到KEGG物种缩写"""
        if pd.isna(organism):
            return None
        
        organism_str = str(organism).strip().lower()
        
        # 常见物种映射
        organism_mapping = {
            'escherichia coli': 'eco',
            'Corynebacterium glutamicum': 'cgl', 
        
        }
        
        for name, abbrev in organism_mapping.items():
            if name in organism_str:
                return abbrev
        
        return None
    
    def get_kegg_mapping_via_api(self, ec_number: str, organism: str = None) -> List[Dict]:
        """
        通过KEGG API获取EC到基因的映射
        """
        mappings = []
        try:
            # 获取EC对应的所有基因
            ec_url = f"{self.kegg_api_base}/link/genes/{ec_number}"
            response = requests.get(ec_url, timeout=30)
            
            if response.status_code == 200:
                lines = response.text.strip().split('\n')
                for line in lines:
                    if line:
                        parts = line.split('\t')
                        if len(parts) == 2:
                            gene_id = parts[0].replace('gn:', '')
                            ec_info = parts[1]
                            
                            # 如果指定了生物体，进行过滤
                            if organism:
                                if gene_id.startswith(organism):
                                    mappings.append({
                                        'ec_number': ec_number,
                                        'kegg_gene_id': gene_id,
                                        'organism': gene_id.split(':')[0]
                                    })
                            else:
                                mappings.append({
                                    'ec_number': ec_number,
                                    'kegg_gene_id': gene_id,
                                    'organism': gene_id.split(':')[0]
                                })
            
            return mappings
            
        except Exception as e:
            print(f"KEGG API查询错误 {ec_number}: {str(e)}")
            return []
    
    def get_uniprot_mapping_via_api(self, kegg_gene_id: str) -> Optional[str]:
        """
        通过UniProt API获取KEGG基因到UniProt的映射
        """
        try:
            # 从KEGG基因ID提取物种和基因名
            organism, gene_name = kegg_gene_id.split(':', 1)
            
            # 查询UniProt API
            uniprot_url = f"{self.uniprot_api_base}/proteins"
            params = {
                'gene': gene_name,
                'organism': organism,
                'reviewed': True,  # 只获取Swiss-Prot reviewed条目
                'size': 1
            }
            
            response = requests.get(uniprot_url, params=params, timeout=30)
            
            if response.status_code == 200:
                data = response.json()
                if data and len(data) > 0:
                    return data[0]['accession']
            
            return None
            
        except Exception as e:
            print(f"UniProt API查询错误 {kegg_gene_id}: {str(e)}")
            return None
    
    def build_mapping_database(self, kcat_df: pd.DataFrame, output_file: str = None) -> pd.DataFrame:
        """
        构建EC-KEGG基因-UniProt映射数据库
        """
        all_mappings = []
        
        # 获取唯一的EC编号
        unique_ecs = kcat_df['ec_number_clean'].dropna().unique()
        
        print(f"正在为 {len(unique_ecs)} 个EC编号构建映射数据库...")
        
        for i, ec in enumerate(unique_ecs):
            if i % 10 == 0:
                print(f"进度: {i}/{len(unique_ecs)}")
            
            # 获取KEGG基因映射
            kegg_mappings = self.get_kegg_mapping_via_api(ec)
            
            for kegg_mapping in kegg_mappings:
                # 获取UniProt映射
                uniprot_id = self.get_uniprot_mapping_via_api(kegg_mapping['kegg_gene_id'])
                
                if uniprot_id:
                    mapping_record = {
                        'ec_number': ec,
                        'kegg_gene_id': kegg_mapping['kegg_gene_id'],
                        'uniprot_id': uniprot_id,
                        'organism': kegg_mapping['organism']
                    }
                    all_mappings.append(mapping_record)
        
        mapping_df = pd.DataFrame(all_mappings)
        
        if output_file:
            mapping_df.to_csv(output_file, index=False)
            print(f"映射数据库已保存至: {output_file}")
        
        return mapping_df
    
    def comprehensive_matching(self, 
                             kcat_file: str,
                             proteomics_file: str,
                             mapping_file: str = None,
                             output_file: str = None) -> pd.DataFrame:
        """
        综合匹配流程
        """
        print("正在加载数据...")
        kcat_df = self.load_kcat_data(kcat_file)
        proteomics_df = self.load_proteomics_data(proteomics_file)
        
        # 如果没有映射文件，则构建一个
        if mapping_file:
            mapping_df = pd.read_csv(mapping_file)
        else:
            mapping_df = self.build_mapping_database(kcat_df, "ec_kegg_uniprot_mapping.csv")
        
        print(f"kcat数据: {len(kcat_df)} 条记录")
        print(f"蛋白质组数据: {len(proteomics_df)} 条记录") 
        print(f"映射数据: {len(mapping_df)} 条记录")
        
        # 第一步: 通过EC编号连接kcat和映射数据
        print("通过EC编号匹配kcat和映射数据...")
        kcat_mapped = pd.merge(
            kcat_df,
            mapping_df,
            on='ec_number_clean',
            how='inner'
        )
        
        # 第二步: 通过UniProt ID连接蛋白质组数据
        print("通过UniProt ID匹配蛋白质组数据...")
        final_matched = pd.merge(
            kcat_mapped,
            proteomics_df,
            left_on='uniprot_id',
            right_on='uniprot_id_clean',
            how='inner',
            suffixes=('_kcat', '_proteomics')
        )
        
        if output_file:
            final_matched.to_csv(output_file, index=False)
            print(f"匹配结果已保存至: {output_file}")
        
        # 输出统计信息
        self.print_matching_statistics(final_matched)
        

        
    
    def print_matching_statistics(self, matched_df: pd.DataFrame):
        """打印匹配统计信息"""
        print("\n=== 匹配统计 ===")
        print(f"成功匹配的记录数: {len(matched_df)}")
        print(f"涉及唯一EC编号: {matched_df['ec_number_clean'].nunique()}")
        print(f"涉及唯一KEGG基因: {matched_df['kegg_gene_id'].nunique()}")
        print(f"涉及唯一UniProt蛋白: {matched_df['uniprot_id'].nunique()}")
        
        # 按生物体统计
        if 'organism' in matched_df.columns:
            org_stats = matched_df['organism'].value_counts().head(5)
            print("\n前5个生物体分布:")
            for org, count in org_stats.items():
                print(f"  {org}: {count} 条记录")
